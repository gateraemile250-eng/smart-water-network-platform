POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=smart_water
POSTGRES_USER=smart_water_user
POSTGRES_PASSWORD=your_password_here

# Used by Airflow. Generate a value with:
#   python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_JWT_SECRET=generate_a_long_random_value
# Absolute path of this repository on the HOST machine. Airflow passes it to
# Docker to start the ML containers. Keep the single quotes so backslashes
# stay literal. Example: 'C:\Users\you\Documents\Smart-water-network-platform'
SMART_WATER_PROJECT_PATH='C:\path\to\Smart-water-network-platform'