{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SmartWaterLakeBucketAccess",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::<bucket-name>"
    },
    {
      "Sid": "SmartWaterLakeReadAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::<bucket-name>/*"
    },
    {
      "Sid": "SmartWaterLakePublishAccess",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": [
        "arn:aws:s3:::<bucket-name>/raw/*",
        "arn:aws:s3:::<bucket-name>/processed/*",
        "arn:aws:s3:::<bucket-name>/curated/*",
        "arn:aws:s3:::<bucket-name>/manifests/*"
      ]
    }
  ]
}
